{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Channel narrative profile",
  "type": "object",
  "required": ["profile_id", "channel_id", "sample_video_ids", "sample_count", "status", "hook_patterns", "structure_patterns", "evidence_order", "pacing", "uncertainty", "cta", "anti_patterns", "signature_elements_do_not_reuse", "limitations"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "channel_id": {"type": "string", "minLength": 1},
    "sample_video_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 3},
    "sample_count": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"enum": ["PROVISIONAL", "EVIDENCE_SUFFICIENT"]},
    "hook_patterns": {"type": "array", "items": {"type": "string"}},
    "structure_patterns": {"type": "array", "items": {"type": "string"}},
    "evidence_order": {"type": "array", "items": {"type": "string"}},
    "pacing": {"type": "string"},
    "uncertainty": {"type": "string"},
    "cta": {"type": "string"},
    "anti_patterns": {"type": "array", "items": {"type": "string"}},
    "signature_elements_do_not_reuse": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
