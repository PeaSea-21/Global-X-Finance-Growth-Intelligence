{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVP run manifest",
  "type": "object",
  "required": ["run_id", "created_at", "skill_version", "status", "channel_count", "video_count", "transcript_request_count", "network_calls", "estimated_cost_usd", "cache", "checks", "limitations"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "skill_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["READY", "BLOCKED", "PARTIAL", "FAILED"]},
    "channel_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "video_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "transcript_request_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "network_calls": {"type": "integer", "minimum": 0},
    "estimated_cost_usd": {"type": "number", "minimum": 0},
    "cache": {"type": "object"},
    "checks": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
